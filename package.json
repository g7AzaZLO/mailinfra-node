{
  "name": "mailinfra",
  "version": "0.1.0",
  "description": "Официальный SDK MailInfra для Node.js и TypeScript — email API для разработчиков",
  "license": "MIT",
  "author": "MailInfra",
  "homepage": "https://docs.mailinfra.ru",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/g7AzaZLO/mailinfra-node.git"
  },
  "bugs": "https://github.com/g7AzaZLO/mailinfra-node/issues",
  "keywords": [
    "mailinfra",
    "email",
    "transactional-email",
    "smtp",
    "api-client",
    "webhooks"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "check:dist": "node scripts/check-dist.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.14.0",
    "openapi-typescript": "^7.4.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "undici": "^6.21.0",
    "vitest": "^2.1.8"
  }
}
